rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 설문 한 건: surveys/{설문ID}
    //  - 모든 화면이 읽습니다(첫 화면 목록, 응답 화면, 관리 화면).
    //  - 편집기·관리 화면이 만들고 고치고 지웁니다. (관리자 인증을 붙이면 request.auth != null로 제한하세요)
    match /surveys/{surveyId} {
      allow read: if true;
      allow create, update, delete: if true;

      // 이 설문의 대상자(토큰) — 응답 화면이 읽고 열람·제출 시각을 갱신, 관리 화면이 만들고 지움
      match /recipients/{token} {
        allow read: if true;
        allow create, update, delete: if true;
      }

      // 이 설문의 응답 — 누구나 새 응답을 만들 수 있지만 수정·삭제는 관리 화면(설문 삭제)만
      match /responses/{id} {
        allow create: if request.resource.data.keys().hasAll(['answers', 'submittedAt'])
                      && request.resource.data.submittedAt == request.time;
        allow read: if true;
        allow update: if false;
        allow delete: if true;
      }
    }

    // 예전 구조(가져오기 전용). 새 구조로 옮긴 뒤에는 이 세 블록을 지워도 됩니다.
    match /config/{doc} { allow read: if true; allow write: if false; }
    match /recipients/{token} { allow read: if true; allow write: if false; }
    match /responses/{id} { allow read: if true; allow write: if false; }
  }
}
